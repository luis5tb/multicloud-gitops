  #- name: acme-agent-redhat-sso-production
  #  vaultPrefixes:
  #  - global
  #  fields:
  #  - name: client-id
  #    onMissingValue: prompt
  #  - name: client-secret
  #    onMissingValue: prompt
  #- name: acme-agent-redhat-sso-stage
  #  vaultPrefixes:
  #  - global
  #  fields:
  #  - name: client-id
  #    onMissingValue: prompt
  #  - name: client-secret
  #    onMissingValue: prompt

