# Secrets documentation can be found here:
# https://validatedpatterns.io/learn/secrets-management-in-the-validated-patterns-framework/
#
# A more formal description of this format can be found here:
# https://github.com/validatedpatterns/rhvp.cluster_utils/tree/main/roles/vault_utils#values-secret-file-format
version: "2.0"
# Ideally you NEVER COMMIT THESE VALUES TO GIT (although if all passwords are
# automatically generated inside the vault this should not really matter)

# Alphanumeric-only generation policy for OAuth client secrets sent by
# clients that do NOT form-URL-encode Basic credentials (RFC 6749 s2.3.1).
# VERIFIED-BROKEN LIVE (2026-11-20): the pinned Praxis oauth delegator
# (ghcr.io/praxis-proxy/ai:0.4.1) sends client_secret_basic unencoded; a
# validatedPatternDefaultPolicy secret containing '%' made Keycloak fail to
# decode the credentials (`unauthorized_client: Unexpected error when
# authenticating client`, event clientId="null"), so every spoke-gateway
# A->U exchange failed. Use this policy for any secret Praxis presents.
vaultPolicies:
  alphaNumericPolicy: |
    length=32
    rule "charset" { charset = "abcdefghijklmnopqrstuvwxyz" min-chars = 1 }
    rule "charset" { charset = "ABCDEFGHIJKLMNOPQRSTUVWXYZ" min-chars = 1 }
    rule "charset" { charset = "0123456789" min-chars = 1 }

secrets:
  - name: rhbk
    vaultPrefixes:
    - global
    fields:
    - name: admin-password
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
    - name: db-password
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
    # openshift-console's Native OIDC client secret
    # (charts/all/keycloak-oidc's keycloak.consoleClientSecretVaultKey /
    # openshiftOIDC.consoleClientSecretName) -- generating it here instead of
    # letting Keycloak generate one at import time removes the manual
    # Admin Console copy step from charts/all/keycloak-oidc/README.md.
    - name: console-client-secret
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
    # Initial (temporary: true, must-change-on-first-login) password for the
    # optional in-realm human admin user
    # (charts/all/keycloak-oidc's keycloak.consoleAdminUser).
    - name: console-admin-password
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy

  # Confidential client secret for the per-spoke Praxis spoke-gateways'
  # RFC 8693 token exchange (B1, enabled in the standalone variant;
  # charts/all/keycloak-oidc's keycloak.spokeGatewayExchanger.vaultKey and
  # charts/all/praxis-proxy's spokeGateways.exchangeClient). MUST use
  # alphaNumericPolicy: Praxis sends it unencoded over Basic auth (see the
  # vaultPolicies note above).
  - name: praxis-spoke-gateway
    vaultPrefixes:
    - global
    fields:
    - name: praxis-spoke-gateway-client-secret
      onMissingValue: generate
      vaultPolicy: alphaNumericPolicy

  # Separate confidential client for the disabled-by-default spoke Execution
  # gateways (praxis-spoke-<key>-exec). Do not reuse the read gateway's
  # credential: the distinct exchanger ID is also R_exec's required audience.
  # MUST use alphaNumericPolicy because the pinned Praxis delegator sends
  # Basic client authentication without URL-encoding its secret.
  - name: praxis-spoke-gateway-exec
    vaultPrefixes:
    - global
    fields:
    - name: praxis-spoke-gateway-exec-client-secret
      onMissingValue: generate
      vaultPolicy: alphaNumericPolicy

  # Confidential client secret of the Praxis HUB GATEWAY's exchanger
  # (client mas-a2a; charts/all/keycloak-oidc keycloak.hubGatewayExchanger,
  # charts/all/praxis-proxy a2aUpstream.exchange). MUST use
  # alphaNumericPolicy: Praxis sends it unencoded over Basic auth.
  - name: praxis-hub-exchange
    vaultPrefixes:
    - global
    fields:
    - name: praxis-hub-exchange-client-secret
      onMissingValue: generate
      vaultPolicy: alphaNumericPolicy

  # Confidential client secret for the hub A2A adapter's H->R token
  # exchange in standalone hub-gateway mode (A->H in legacy adapter mode;
  # charts/all/lightspeed-hub's
  # adapter.keycloak.clientSecretSecret / KEYCLOAK_CLIENT_SECRET env),
  # consumed via the keycloak-oidc chart's hub-exchange-secret
  # ExternalSecrets into the adapter's KEYCLOAK_CLIENT_SECRET env.
  # Enabled with lightspeed-hub in the standalone variant. Preserve existing
  # Vault values when repairing client registration; do not rotate to fix an
  # import placeholder. The keycloak-oidc PostSync hook aligns registration
  # with this value after ExternalSecrets have refreshed.
  - name: lightspeed-hub-adapter
    vaultPrefixes:
    - global
    fields:
    - name: lightspeed-hub-adapter-client-secret
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy

  # Vertex AI (Gemini) Application Default Credentials, shared pattern-wide.
  # Consumed by charts/all/mao/mas-worker's vertexCreds ExternalSecret (the
  # orchestrator's google_genai/Vertex LLM resource), and available for any
  # future consumer (e.g. the planned lightspeed-hub) that needs Vertex
  # credentials. Point "path" at your Google Application Default Credentials
  # JSON file; load-secrets prompts for it if that path is missing rather
  # than skipping it silently.
  - name: llm-creds-vertex
    vaultPrefixes:
    - global
    fields:
    - name: credentials
      path: ~/.config/gcloud/application_default_credentials.json
      onMissingValue: prompt

  # LiteLLM API key for charts/all/acme-agent (litellm.vaultKey).
  # Required when the acme-agent application is enabled in
  # variants/standalone/values-standalone.yaml.
  - name: acme-agent-litellm
    vaultPrefixes:
    - global
    fields:
    - name: api-key
      onMissingValue: prompt

  # Fernet keys shared by charts/all/mao/mas-api, mas-worker and mas-a2a
  # (runCredentials.vault). They seal the A2A caller's credentials while a
  # task waits for, and runs on, the Temporal workers; the API, worker and
  # A2A service all refuse to start without them. Vault's "generate" cannot produce a Fernet key, so
  # supply a JSON array, newest key first, e.g. '["<key>"]', where <key> is:
  #   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
  # To rotate, store '["<new>","<old>"]' and remove <old> once no task uses it.
  - name: mao-run-credentials
    vaultPrefixes:
    - global
    fields:
    - name: keys
      onMissingValue: prompt

  # Red Hat SSO client credentials shared by the praxis-proxy egress gateways
  # (egressGateways.<key>.clientSecret.vaultKey -- the Ask Red Hat gateway's
  # client), Keycloak's externalOidcProviders[].credentials and ACME's optional
  # auth.redhatSso ExternalSecrets. All read these SAME Vault records.
  # Enable the entries for the environments configured in
  # variants/standalone/values-standalone.yaml. These are the Vault source
  # entries; the chart creates the Kubernetes target Secret
  # acme-agent-redhat-sso and Keycloak's per-provider Secrets from them.
  #
  #- name: acme-agent-redhat-sso-production
  #  vaultPrefixes:
  #  - global
  #  fields:
  #  - name: client-id
  #    onMissingValue: prompt
  #  - name: client-secret
  #    onMissingValue: prompt
  #- name: acme-agent-redhat-sso-stage
  #  vaultPrefixes:
  #  - global
  #  fields:
