# Secrets documentation can be found here:
# https://validatedpatterns.io/learn/secrets-management-in-the-validated-patterns-framework/
#
# A more formal description of this format can be found here:
# https://github.com/validatedpatterns/rhvp.cluster_utils/tree/main/roles/vault_utils#values-secret-file-format
version: "2.0"
# Ideally you NEVER COMMIT THESE VALUES TO GIT (although if all passwords are
# automatically generated inside the vault this should not really matter)

secrets:
  - name: rhbk
    vaultPrefixes:
    - global
    fields:
    - name: admin-password
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
    - name: db-password
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
    # openshift-console's Native OIDC client secret
    # (charts/all/keycloak-oidc's keycloak.consoleClientSecretVaultKey /
    # openshiftOIDC.consoleClientSecretName) -- generating it here instead of
    # letting Keycloak generate one at import time removes the manual
    # Admin Console copy step from charts/all/keycloak-oidc/README.md.
    - name: console-client-secret
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
    # Initial (temporary: true, must-change-on-first-login) password for the
    # optional in-realm human admin user
    # (charts/all/keycloak-oidc's keycloak.consoleAdminUser).
    - name: console-admin-password
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy

  # Vertex AI (Gemini) credentials for charts/all/openshift-lightspeed-config's
  # OLSConfig google_vertex provider (the default LLM provider -- see that
  # chart's values.yaml llm.defaultProvider). Its externalsecret-vertex.yaml
  # renders unconditionally, so this block must stay active: a commented-out
  # entry here makes the ExternalSecret fail to resolve and silently wedges
  # the sync. Point "path" at your Google Application Default Credentials JSON
  # file; load-secrets prompts for it if that path is missing rather than
  # skipping it silently.
  - name: llm-creds-vertex
    vaultPrefixes:
    - global
    fields:
    - name: credentials
      path: ~/.config/gcloud/application_default_credentials.json
      onMissingValue: prompt

  # LiteLLM API key for charts/all/acme-agent (litellm.vaultKey).
  # Required when the acme-agent application is enabled in
  # variants/standalone/values-standalone.yaml.
  - name: acme-agent-litellm
    vaultPrefixes:
    - global
    fields:
    - name: api-key
      onMissingValue: prompt

