# Secrets documentation can be found here:
# https://validatedpatterns.io/learn/secrets-management-in-the-validated-patterns-framework/
#
# A more formal description of this format can be found here:
# https://github.com/validatedpatterns/rhvp.cluster_utils/tree/main/roles/vault_utils#values-secret-file-format
version: "2.0"
# Ideally you NEVER COMMIT THESE VALUES TO GIT (although if all passwords are
# automatically generated inside the vault this should not really matter)

secrets:
  - name: rhbk
    vaultPrefixes:
    - global
    fields:
    - name: admin-password
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
    - name: db-password
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy

  # LLMProvider credentials for charts/all/lightspeed-agentic-operator.
  # Only one is needed -- whichever llmProvider.type you select in
  # variants/standalone/values-standalone.yaml (set llmProvider.enabled too).

  # Vertex AI (Anthropic): point "path" at your own Google Application
  # Default Credentials JSON file.
  #- name: llm-creds-vertex
  #  vaultPrefixes:
  #  - global
  #  fields:
  #  - name: credentials
  #    path: ~/.config/gcloud/application_default_credentials.json

  # OpenAI: prompts for the API key interactively during load-secrets.
  #- name: llm-creds-openai
  #  vaultPrefixes:
  #  - global
  #  fields:
  #  - name: api-key
  #    onMissingValue: prompt

  # LiteLLM API key for charts/all/rca-agent (litellm.vaultKey). Required
  # when the rca-agent application is enabled in
  # variants/standalone/values-standalone.yaml.
  - name: rca-agent-litellm
    vaultPrefixes:
    - global
    fields:
    - name: api-key
      onMissingValue: prompt

  # LiteLLM API key for charts/all/ericsson-agent (litellm.vaultKey).
  # Required when the ericsson-agent application is enabled in
  # variants/standalone/values-standalone.yaml.
  - name: ericsson-agent-litellm
    vaultPrefixes:
    - global
    fields:
    - name: api-key
      onMissingValue: prompt

